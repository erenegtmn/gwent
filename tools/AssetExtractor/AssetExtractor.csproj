<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CS8981;CA1416;MSB3277;CS0618</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- WolvenKit-7 (Witcher 3) kütüphaneleri: tools/_downloads/wolvenkit7 (depoya girmez, elle indirilir) -->
  <PropertyGroup>
    <WK>$(MSBuildThisFileDirectory)..\_downloads\wolvenkit7\</WK>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="WolvenKit.Common"><HintPath>$(WK)WolvenKit.Common.dll</HintPath></Reference>
    <Reference Include="WolvenKit.Bundles"><HintPath>$(WK)WolvenKit.Bundles.dll</HintPath></Reference>
    <Reference Include="WolvenKit.Cache"><HintPath>$(WK)WolvenKit.Cache.dll</HintPath></Reference>
    <Reference Include="WolvenKit.Wwise"><HintPath>$(WK)WolvenKit.Wwise.dll</HintPath></Reference>
    <Reference Include="WolvenKit.W3Strings"><HintPath>$(WK)WolvenKit.W3Strings.dll</HintPath></Reference>
    <Reference Include="WolvenKit.CR2W"><HintPath>$(WK)WolvenKit.CR2W.dll</HintPath></Reference>
  </ItemGroup>

  <!-- Çalışma zamanı bağımlılıkları (Doboz, Snappy, LZ4, ...) için tüm DLL'leri yanına kopyala -->
  <Target Name="CopyWolvenDlls" AfterTargets="Build">
    <ItemGroup>
      <WkDll Include="$(WK)*.dll;$(WK)*.config" Exclude="$(WK)System.*.dll;$(WK)Microsoft.*.dll;$(WK)WindowsBase.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WkDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
