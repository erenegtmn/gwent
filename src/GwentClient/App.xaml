<Application x:Class="GwentClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GwentClient">
    <Application.Resources>

        <DropShadowEffect x:Key="GoldGlow" Color="#e8c970" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />

        <!-- Oyun arayüzü düğmesi: kesik köşeli plaka, çift çizgi; üzerine gelince altın ışık -->
        <Style x:Key="GBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#e8dcc4" />
            <Setter Property="Background" Value="#241b11" />
            <Setter Property="BorderBrush" Value="#8a7236" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="Transparent">
                            <local:ChamferFrame x:Name="fr" Fill="{TemplateBinding Background}" Edge="{TemplateBinding BorderBrush}" Inner="#44e0bf6a" Cut="9" Inset="4" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fr" Property="Fill" Value="#3b2c18" />
                                <Setter TargetName="fr" Property="Edge" Value="#e8c970" />
                                <Setter TargetName="fr" Property="Effect" Value="{StaticResource GoldGlow}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1.5" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GBtnPrimary" TargetType="Button" BasedOn="{StaticResource GBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#ecd083" Offset="0" />
                        <GradientStop Color="#b38a38" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#1a1209" />
            <Setter Property="BorderBrush" Value="#f4e0a0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="Transparent">
                            <local:ChamferFrame x:Name="fr" Fill="{TemplateBinding Background}" Edge="{TemplateBinding BorderBrush}" Inner="#66fff2c0" Cut="9" Inset="4" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fr" Property="Edge" Value="#ffffff" />
                                <Setter TargetName="fr" Property="Effect" Value="{StaticResource GoldGlow}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1.5" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#e8dcc4" />
            <Setter Property="Background" Value="#1d150d" />
            <Setter Property="BorderBrush" Value="#4a3b28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="root" Background="Transparent">
                            <local:ChamferFrame x:Name="fr" Fill="{TemplateBinding Background}" Edge="{TemplateBinding BorderBrush}" Inner="#00000000" Cut="8" Inset="4" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fr" Property="Edge" Value="#a88a40" />
                                <Setter TargetName="fr" Property="Fill" Value="#2a2013" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fr" Property="Edge" Value="#f0d890" />
                                <Setter TargetName="fr" Property="Fill" Value="#3d2e18" />
                                <Setter TargetName="fr" Property="Inner" Value="#88e0bf6a" />
                                <Setter TargetName="fr" Property="Effect" Value="{StaticResource GoldGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GText" TargetType="TextBox">
            <Setter Property="Foreground" Value="#e8dcc4" />
            <Setter Property="Background" Value="#100b06" />
            <Setter Property="BorderBrush" Value="#8a7236" />
            <Setter Property="CaretBrush" Value="#e8dcc4" />
            <Setter Property="SelectionBrush" Value="#8a6e2c" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <local:ChamferFrame x:Name="fr" Fill="{TemplateBinding Background}" Edge="{TemplateBinding BorderBrush}" Inner="#00000000" Cut="7" Inset="3" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="fr" Property="Edge" Value="#f0d890" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- İnce, koyu kaydırma çubuğu: altın başparmak -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#22000000" Width="9">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" Focusable="False" /></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Border Background="#8a6e2c" CornerRadius="3" Margin="1,0" /></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="9" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#22000000" Height="9">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False" Focusable="False" /></Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False" Focusable="False" /></Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb"><Border Background="#8a6e2c" CornerRadius="3" Margin="0,1" /></ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e8dcc4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#f4ecd8" />
            <Setter Property="Foreground" Value="#18130c" />
            <Setter Property="BorderBrush" Value="#8a7236" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Application.Resources>
</Application>
