<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Gwent</AssemblyName>
    <RootNamespace>GwentClient</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Sürüm: GitHub release etiketi "v" + bu sayı olmalı (UpdateCheck) -->
    <Version>0.7.1</Version>
    <!-- Dağıtım kanalı: "main" yayındaki oyun; başka kanal (ör. kaermorhen denemesi) güncelleme denetimi yapmaz, üzerine ana sürüm yazılmaz -->
    <GwentChannel Condition="'$(GwentChannel)' == ''">main</GwentChannel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GwentChannel" Value="$(GwentChannel)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GwentCore\GwentCore.csproj" />
    <ProjectReference Include="..\GwentAI\GwentAI.csproj" />
    <ProjectReference Include="..\GwentNet\GwentNet.csproj" />
    <ProjectReference Include="..\GwentServer\GwentServer.csproj" />
    <ProjectReference Include="..\GwentHost\GwentHost.csproj" />
    <ProjectReference Include="..\KaerMorhen.Core\KaerMorhen.Core.csproj" />
  </ItemGroup>

</Project>
